# Copia este archivo a .env (npm run setup lo hace por ti si no existe).

# Base de datos SQLite local. Para Postgres: postgresql://usuario:clave@host:5432/kiosko
DATABASE_URL="file:./dev.db"

# --- IA (opcional) ---
# Sin claves, ANA usa el intérprete local de pedidos y la demo funciona igual.
# Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini (gratis, respaldo): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Orden de proveedores: groq,gemini,local
LLM_PROVEEDORES=groq,gemini,local

# --- Voz (opcional) ---
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys (permisos: Text to Speech y Speech to Text)
ELEVENLABS_API_KEY=
# Voz CLARI (mujer venezolana) de tu biblioteca. Cámbiala por cualquier voice_id.
ELEVENLABS_VOICE_ID=9Ux14cxOYULytGFBVsW4
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VELOCIDAD=1.05
# Transcribir con ElevenLabs Scribe (1) o no (0). Si no, se usa Groq Whisper con GROQ_API_KEY, o el navegador.
ELEVENLABS_STT=1
ELEVENLABS_STT_MODEL=scribe_v1
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- Datos de la tienda (los ve el cliente) ---
NEXT_PUBLIC_TIENDA_NOMBRE="Minimarket Especias"
NEXT_PUBLIC_TIENDA_LEMA="Condimentos, maní y frutos secos al peso"
NEXT_PUBLIC_MONEDA=USD
NEXT_PUBLIC_PAGO_BANCO="Banesco (0134)"
NEXT_PUBLIC_PAGO_TELEFONO="0414-4141368"
NEXT_PUBLIC_PAGO_CEDULA="82.218.399"

# --- Avatar ---
NEXT_PUBLIC_AVATAR_URL=/models/ana.vrm
# Nodos del modelo que no se muestran, separados por coma (opcional)
NEXT_PUBLIC_AVATAR_OCULTAR=
