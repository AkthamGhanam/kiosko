{
  "name": "kiosko-ana",
  "version": "0.1.0",
  "private": true,
  "description": "Kiosko de autoservicio con ANA, asistente 3D con IA, para Minimarket Especias",
  "scripts": {
    "setup": "node scripts/preparar.mjs",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate"
